# =============================================================================
# Biomedical Equipment Troubleshooting Agent - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# =============================================================================
# APPLICATION MODE
# =============================================================================
# Options: mock, usb
# - mock: Use simulated signals from predefined scenarios (default)
# - usb: Connect to Mastech MS8250D multimeter via USB
APP_MODE=mock

# Mock mode settings
MOCK_SCENARIO=cctv-psu-output-rail

# USB Multimeter settings (for Mastech MS8250D)
# Leave USB_PORT empty for auto-detection
USB_PORT=
USB_BAUD_RATE=2400
USB_TIMEOUT=2.0

# =============================================================================
# LLM Configuration (SELF-HEALING - Multi-Provider with Fallback)
# =============================================================================
# The manager rotates keys → models within a provider, then switches to the
# fallback provider. Default layout: Claude Opus 4.6 primary, Groq fallback.

# Provider selection (lowercase: "anthropic" | "groq" | "openai")
PRIMARY_LLM_PROVIDER=anthropic
FALLBACK_LLM_PROVIDER=groq

# --- Anthropic (Primary) ---
# Single key:
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Or multiple keys (comma-separated) — rotates on rate-limit / 5xx:
# ANTHROPIC_API_KEYS=sk-ant-xxx1,sk-ant-xxx2
# Override model (default: claude-opus-4-6). Comma-separated list supported.
# ANTHROPIC_MODELS=claude-opus-4-6

# --- Groq (Fallback) ---
# Single key or comma-separated list:
GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_KEYS=gsk_xxx1,gsk_xxx2,gsk_xxx3
# Models (comma-separated) — falls back through the list within the Groq slot:
LLM_MODELS=llama-3.3-70b-versatile

# --- Optional: OpenAI as an extra provider slot ---
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODELS=gpt-4o-mini

# Retry Configuration (optional - defaults shown)
MAX_RETRIES_PER_KEY=2
MAX_RETRIES_PER_MODEL=2
BACKOFF_BASE_SECONDS=1.0
BACKOFF_MAX_SECONDS=16.0

# Legacy (still works for backwards compatibility)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# =============================================================================
# EMBEDDINGS CONFIGURATION (RAG)
# =============================================================================
# Local (RECOMMENDED - FREE, no API key needed)
# Uses sentence-transformers on CPU
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================================================
# CHROMA DB Configuration (Embedded Mode - No Docker Required)
# =============================================================================
# ChromaDB runs in embedded mode automatically
# No docker or server needed - works out of the box
CHROMADB_COLLECTION=biomed_equipment

# =============================================================================
# LANGSMITH OBSERVABILITY (FREE TIER)
# =============================================================================
# Sign up: https://smith.langchain.com
# Tracing helps debug and visualize agent behavior
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=biomed-troubleshooter
LANGCHAIN_TRACING=true

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# HTTP API (FastAPI / Cloud Run)
# =============================================================================
# Cloud Run injects PORT automatically; local dev defaults to 8080.
PORT=8080
# Comma-separated list of allowed origins for CORS, or "*" for open access.
API_ALLOWED_ORIGINS=*

# =============================================================================
# IMAGE SERVER CONFIGURATION
# =============================================================================
# Base URL for equipment images
# Dev: http://localhost:8000 (run: python -m http.server 8000 --directory data/equipment)
# Prod: https://images.example.com (or your CDN/Cloudinary URL)
IMAGE_BASE_URL=http://localhost:8000

# =============================================================================
# DATABASE (Postgres / Cloud SQL)
# =============================================================================
# Leave DATABASE_URL blank to fall back to in-memory MemorySaver + YAML
# equipment store. Set it to enable:
#   * Phase A — PostgresSaver checkpointer (survives Cloud Run replica rotation)
#   * Phase B — diagnostic_cases + case_measurements writes + analytics queries
#   * Phase C — optional: switch equipment loader to read from Postgres
#
# Local dev (docker-compose):
#   DATABASE_URL=postgresql://biomed:biomed@localhost:5432/biomed
# Cloud Run + Cloud SQL (Unix socket):
#   DATABASE_URL=postgresql://biomed:PW@/biomed?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# Postgres pool tuning (optional — defaults shown)
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Phase C backend switch — "yaml" (default) or "postgres"
# "postgres" reads equipment.raw_config JSONB at request time; "yaml" reads
# data/equipment/*.yaml from disk. Flip to "postgres" once you've run
# `python scripts/seed_equipment.py`.
EQUIPMENT_STORE=yaml
